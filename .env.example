# Database (Docker example uses host port 5433 if local Postgres already owns 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/coffy

# Frontend (Vite)
PORT=25197
BASE_PATH=/

# API server (separate from Vite PORT)
API_PORT=8080
NODE_ENV=development

# Stripe (test/sandbox — leave empty for pending-order fallback)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
