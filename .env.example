# Database (Docker example uses host port 5433 if local Postgres already owns 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/coffy

# Frontend (Vite)
PORT=25197
BASE_PATH=/

# API server (separate from Vite PORT)
API_PORT=8080
NODE_ENV=development

# Stripe (test/sandbox)
# On Replit: set these as Secrets with the EXACT names below, then restart API + Vite.
# Leave empty locally to use pending-order fallback.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
